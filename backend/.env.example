# Copy this file to backend/.env and fill in real values.
# The server exits immediately if SUPABASE_URL or SUPABASE_SECRET_KEY is missing.

PORT=3000
NODE_ENV=development

# Supabase project settings (service-role key, not the anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# Google OAuth (required to connect Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email-connections/google/callback

# Public frontend URL used after OAuth redirects
FRONTEND_URL=http://127.0.0.1:5500

# Optional
# ENABLE_SCHEDULER=true
# BZADE_CREDENTIAL_ENCRYPTION_KEY=
# SCHEDULER_RETRY_UNIT_MS=60000
